# Copy this file to .env and adjust values.
FLASK_PORT=5000
FLASK_ENV=development

# Analytics stores ONLY safe aggregate metadata (never passwords).
ENABLE_ANALYTICS=true

# Path to the SQLite database used for aggregate analytics.
DATABASE_PATH=analytics.db

# Password policy defaults
MIN_PASSWORD_LENGTH=12
MAX_PASSWORD_LENGTH=256
ENABLE_COMMON_PASSWORD_CHECK=true
ENABLE_PERSONAL_INFO_CHECK=true

# Path to the educational common-password list
COMMON_PASSWORDS_FILE=data/common_passwords.txt